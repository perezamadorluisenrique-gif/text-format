{
  "name": "text-format",
  "version": "0.1.0",
  "description": "Case conversion and copy/OCR cleanup commands for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test 'tests/*.test.ts'",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
